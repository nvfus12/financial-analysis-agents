# ==============================================================================
# Environment Configuration Template for FinAnalyst Agent
# Copy this file to '.env' and fill in your actual API keys.
# ==============================================================================

# --- GOOGLE AI STUDIO (NATIVE GEMINI) SETTINGS ---
# Enter your main Gemini API Key here (Required if not using 9router)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Enter multiple Gemini API Keys separated by commas for load-balancing and retry fallback
# Example: AIzaSyA1..., AIzaSyB2..., AIzaSyC3...
GEMINI_API_KEYS=

# --- 9ROUTER / OPENAI-COMPATIBLE PROXY SETTINGS ---
# Enter your primary provider ('gemini' or '9router')
PRIMARY_PROVIDER=gemini

# Enter your 9router API Key
NINE_ROUTER_API_KEY=

# Enter the 9router Base URL (Default: https://api.9router.com/v1)
NINE_ROUTER_API_BASE=https://api.9router.com/v1

# Override model names if using OpenRouter/9router (Defaults are google/gemini-1.5-flash and google/text-embedding-004)
LLM_MODEL_NAME_OVERRIDE=
EMBEDDING_MODEL_NAME_OVERRIDE=

# Model Configurations (Defaults: gemini-2.0-flash and gemini-2.5-pro)
# You can change these to gemini-2.5-flash, gemini-3.5-flash etc.
LLM_MODEL_NAME_FLASH=gemini-2.0-flash
LLM_MODEL_NAME_PRO=gemini-2.5-pro
LLM_MODEL_NAME_EMBEDDING=models/gemini-embedding-2

# --- ADDITIONAL SERVICES ---
# Llama Cloud API Key for layout-aware PDF table parsing (Free tier: 1000 pages/month)
# Obtain from: https://cloud.llamaindex.ai/
# If left blank, the agent falls back to PyPDF locally.
LLAMA_CLOUD_API_KEY=

# --- APPLICATION DATA PATHS ---
# Relative to workspace root or absolute path
DATABASE_URL=data/finanalyst.db
CHROMA_DB_PATH=data/chroma_store
PDF_UPLOAD_DIR=data/pdf_uploads

# --- LOGGING CONFIGURATION ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
